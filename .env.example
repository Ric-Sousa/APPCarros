# ===================================
# Base de dados
# DB_CLIENT: mysql (também MariaDB) | postgres | mssql (SQL Server) | sqlite
# As tabelas são criadas/atualizadas automaticamente no arranque.
# Use um utilizador dedicado com permissões só sobre esta base de dados, nunca o root/sa.
# ===================================
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=logicar
DB_PASSWORD=
DB_NAME=logicar

# --- SQLite (sem servidor) ---
# DB_CLIENT=sqlite
# DB_FILE=./data/logicar.db

# --- PostgreSQL ---
# DB_CLIENT=postgres
# DB_PORT=5432
# DB_SSL=true                      # ligação SSL (ex.: bases de dados na cloud)

# --- SQL Server ---
# DB_CLIENT=mssql
# DB_PORT=1433
# DB_INSTANCE=SQLEXPRESS           # instância com nome (usa o SQL Browser em vez da porta)
# DB_TRUST_SERVER_CERTIFICATE=true # só em desenvolvimento, com certificado autoassinado
# DB_ENCRYPT=true

# (As variáveis antigas MYSQL_HOST, MYSQL_USER, ... continuam a funcionar com DB_CLIENT=mysql.)

# ===================================
# Servidor
# ===================================
NODE_ENV=development
PORT=5000
# Obrigatório, com pelo menos 32 caracteres. Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Origens permitidas para CORS e Socket.IO, separadas por vírgulas
CORS_ORIGINS=http://localhost:5000,https://www.logicar.pt,https://logicar.pt
# Atrás de um proxy (nginx, plataforma de alojamento): número de proxies (ex.: 1) ou true.
# Sem isto, o limite de tentativas de login trata todos os clientes como um só.
TRUST_PROXY=

# ===================================
# Serviço de dados por matrícula (vehicle_api.php). Usar HTTPS.
# Sem VEHICLE_API_URL a consulta de matrícula fica desligada (o resto funciona).
# VEHICLE_API_KEY: segredo partilhado; definir o mesmo valor no servidor PHP (variável VEHICLE_API_KEY).
# ===================================
VEHICLE_API_URL=
VEHICLE_API_KEY=

# ===================================
# APIs externas (todas opcionais)
# ===================================
# Imagens automáticas dos veículos: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Postos de carregamento EV: https://openchargemap.org/site/develop/api
OPENCHARGEMMAP_API_KEY=
# Meteorologia (sem chave: sem dados meteorológicos): https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Rotas e geocoding (sem chave: distância em linha reta e Nominatim): https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
# Localização usada quando o cliente não indica nenhuma
DEFAULT_LOCATION=Lisboa

# ===================================
# IoT (opcional): sem MQTT_URL o MQTT fica desligado
# ===================================
MQTT_URL=
MQTT_USER=
MQTT_PASS=
