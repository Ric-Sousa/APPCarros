# ===================================
# Base de dados
# DB_CLIENT: mysql (também MariaDB) | postgres | mssql (SQL Server) | sqlite
# As tabelas são criadas/atualizadas automaticamente no arranque.
# Use um utilizador dedicado com permissões só sobre esta base de dados, nunca o root/sa.
# ===================================
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=logicar
DB_PASSWORD=
DB_NAME=logicar

# --- SQLite (sem servidor) ---
# DB_CLIENT=sqlite
# DB_FILE=./data/logicar.db

# --- PostgreSQL ---
# DB_CLIENT=postgres
# DB_PORT=5432
# DB_SSL=true                      # ligação SSL (ex.: bases de dados na cloud)

# --- SQL Server ---
# DB_CLIENT=mssql
# DB_PORT=1433
# DB_INSTANCE=SQLEXPRESS           # instância com nome (usa o SQL Browser em vez da porta)
# DB_TRUST_SERVER_CERTIFICATE=true # só em desenvolvimento, com certificado autoassinado
# DB_ENCRYPT=true

# (As variáveis antigas MYSQL_HOST, MYSQL_USER, ... continuam a funcionar com DB_CLIENT=mysql.)

# ===================================
# Servidor
# ===================================
NODE_ENV=development
PORT=5000
# Obrigatório, com pelo menos 32 caracteres. Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Validade do token de acesso (curto; a sessão é renovada pelo cookie httpOnly de refresh)
JWT_EXPIRES_IN=15m
# Endereço público da app (links nos emails, calendário, Stripe; https ativa o HSTS)
APP_URL=http://localhost:5000
# Emails separados por vírgulas com acesso a /admin (métricas)
ADMIN_EMAILS=
# Origens permitidas para CORS e Socket.IO, separadas por vírgulas
CORS_ORIGINS=http://localhost:5000,https://www.logicar.pt,https://logicar.pt
# Atrás de um proxy (nginx, plataforma de alojamento): número de proxies (ex.: 1) ou true.
# Sem isto, o limite de tentativas de login trata todos os clientes como um só.
TRUST_PROXY=

# ===================================
# Serviço de dados por matrícula (vehicle_api.php). Usar HTTPS.
# Sem VEHICLE_API_URL a consulta de matrícula fica desligada (o resto funciona).
# VEHICLE_API_KEY: segredo partilhado; definir o mesmo valor no servidor PHP (variável VEHICLE_API_KEY).
# ===================================
VEHICLE_API_URL=
VEHICLE_API_KEY=

# ===================================
# APIs externas (todas opcionais)
# ===================================
# Imagens automáticas dos veículos: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Postos de carregamento EV: https://openchargemap.org/site/develop/api
OPENCHARGEMMAP_API_KEY=
# Meteorologia (sem chave: sem dados meteorológicos): https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Rotas e geocoding (sem chave: distância em linha reta e Nominatim): https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
# Localização usada quando o cliente não indica nenhuma
DEFAULT_LOCATION=Lisboa

# ===================================
# Email (verificação, recuperar palavra-passe, lembretes)
# Sem SMTP_URL os emails são gravados como .html em DEV_MAIL_DIR (./data/mail) — só para desenvolvimento.
# ===================================
SMTP_URL=                          # ex.: smtps://utilizador:senha@smtp.exemplo.pt:465
MAIL_FROM=Logicar <nao-responder@logicar.pt>
SUPPORT_EMAIL=suporte@logicar.pt   # recebe o feedback dos utilizadores
DEV_MAIL_DIR=

# ===================================
# Lembretes (email + notificações push)
# ===================================
NOTIFY_HOUR=9                      # hora UTC do envio diário
NOTIFICATIONS_ENABLED=true         # false desliga o agendador
# Chaves VAPID para Web Push. Sem elas, em desenvolvimento são geradas em data/vapid.json.
# Gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@logicar.pt

# ===================================
# Pagamentos (Stripe). Sem STRIPE_SECRET_KEY, em desenvolvimento os planos ativam-se sem pagamento.
# ===================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # endpoint: APP_URL/api/billing/webhook
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUSINESS=

# ===================================
# Ficheiros em S3 / compatível (R2, MinIO, ...). Sem S3_BUCKET ficam em ./uploads.
# ===================================
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# ===================================
# Monitorização de erros (Sentry, opcional)
# ===================================
SENTRY_DSN=

# ===================================
# Backups (npm run backup)
# ===================================
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ===================================
# IoT (opcional, experimental): FEATURE_IOT=true mostra a área IoT; sem MQTT_URL o MQTT fica desligado
# ===================================
FEATURE_IOT=false
MQTT_URL=
MQTT_USER=
MQTT_PASS=
